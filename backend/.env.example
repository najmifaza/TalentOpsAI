# Application
APP_NAME="TalentOps AI Backend"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# CORS (JSON string array)
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","https://talentops.vercel.app","https://talentops.fawt.biz.id"]'

# Database (MariaDB 12 Tables ACID)
# Async URL for FastAPI aiomysql
DATABASE_URL="mysql+aiomysql://talentops_app:talentops_password@127.0.0.1:3306/talentops_db"
# Sync URL for DDL/migrations with PyMySQL
SYNC_DATABASE_URL="mysql+pymysql://talentops_app:talentops_password@127.0.0.1:3306/talentops_db"

# Security & KMS
MASTER_KEK="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=" # Base64 32-byte key
HMAC_PEPPER="talentops_hmac_secret_pepper_2026"
JWT_SECRET="talentops_jwt_secret_dev_key_super_secure_32bytes"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# LLM Gateway Adapter (9router / Antigravity Gemini 3.8)
LLM_ROUTER_BASE_URL="http://127.0.0.1:20128/v1"
LLM_ROUTER_API_KEY="sk-your-9router-api-key"
LLM_API_KEY=""
LLM_ROUTER_PROVIDER="antigravity"
LLM_MODEL_NAME="ag/gemini-3.8-flash-low"
LLM_FALLBACK_MODEL="ag/gemini-3.8-flash-high"
LLM_TEMPERATURE=0.0
LLM_THINKING_LEVEL="low"
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3
NO_PROXY="127.0.0.1,localhost"

# External Integrations
GITHUB_TOKEN=""
DEMO_MODE=True

# Multi-Worker Shared State (Redis)
# Leave empty for single-worker dev; required when running uvicorn --workers > 1
REDIS_URL=""
REDIS_KEY_PREFIX="talentops"
TRIAGE_CONCURRENCY_LIMIT=3
SSE_HISTORY_MAX_EVENTS=200

# Google Calendar OAuth2 (live two-way sync)
# Leave GOOGLE_CLIENT_ID/SECRET empty to stay on the [MOCK / SANDBOX] adapter.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/calendar/oauth/callback"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_HTTP_TIMEOUT=15.0
# Frontend page the OAuth callback redirects back to (tokens never appear in the URL)
OAUTH_SUCCESS_REDIRECT="https://talentops.vercel.app/admin/dashboard"

# Transactional Email (Resend)
# EMAIL_PROVIDER: "resend_api" (HTTPS) | "resend_smtp" (SMTP relay) | "" (disabled)
EMAIL_PROVIDER=""
RESEND_API_KEY=""
RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT=465
RESEND_SMTP_USER="resend"
EMAIL_FROM="TalentOps AI <noreply@talentops.fawt.biz.id>"
EMAIL_REPLY_TO=""
EMAIL_TIMEOUT=15.0
EMAIL_MAX_RETRIES=2
